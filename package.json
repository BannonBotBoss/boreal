{
  "name": "boreal-script-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:slow": "tsx --test tests/slow/*.test.ts",
    "system-map": "tsx tools/system-map.ts",
    "build:wasm": "node tools/build-wasm.mjs",
    "test:rust": "cargo test --manifest-path rust/boreal-sim/Cargo.toml"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "katex": "^0.19.1",
    "three": "npm:super-three@0.185.0"
  },
  "overrides": {
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/three": "0.185.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
