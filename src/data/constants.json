{
  "_doc": "Single source of truth for constants (docs/constants.md). 'base' = inputs; 'derived' = computed from base in order by src/core/constants.ts. Choice of base inputs is the SI convention (2019 redefinition), not physics: G cannot be derived and is measured. Rust gets rust/boreal-sim/src/constants.rs from tools/gen-constants.ts.",
  "base": {
    "c":        { "value": 299792458, "unit": "m/s", "uncertainty": 0, "source": "SI 2019 defining constant (BIPM SI Brochure 9th ed.)" },
    "h":        { "value": 6.62607015e-34, "unit": "J s", "uncertainty": 0, "source": "SI 2019 defining constant" },
    "e":        { "value": 1.602176634e-19, "unit": "C", "uncertainty": 0, "source": "SI 2019 defining constant" },
    "k_B":      { "value": 1.380649e-23, "unit": "J/K", "uncertainty": 0, "source": "SI 2019 defining constant" },
    "N_A":      { "value": 6.02214076e23, "unit": "1/mol", "uncertainty": 0, "source": "SI 2019 defining constant" },
    "dnu_Cs":   { "value": 9192631770, "unit": "Hz", "uncertainty": 0, "source": "SI 2019 defining constant (Cs-133 hyperfine)" },
    "K_cd":     { "value": 683, "unit": "lm/W", "uncertainty": 0, "source": "SI 2019 defining constant (540 THz luminous efficacy)" },
    "alpha":    { "value": 7.2973525693e-3, "unit": "1", "uncertainty": 1.1e-12, "source": "CODATA 2018 (Tiesinga et al. 2021, RMP 93:025010)" },
    "R_inf":    { "value": 10973731.568160, "unit": "1/m", "uncertainty": 2.1e-5, "source": "CODATA 2018 Rydberg constant" },
    "me_mp":    { "value": 5.44617021487e-4, "unit": "1", "uncertainty": 3.3e-14, "source": "CODATA 2018 electron/proton mass ratio" },
    "G":        { "value": 6.67430e-11, "unit": "m^3/(kg s^2)", "uncertainty": 1.5e-15, "source": "CODATA 2018 (measured, not derivable)", "locked": true, "range": [6.0e-11, 7.4e-11] },
    "GM_sun":   { "value": 1.3271244e20, "unit": "m^3/s^2", "uncertainty": 1e10, "source": "IAU 2015 Resolution B3 nominal (held fixed when G changes)" },
    "R_sun":    { "value": 6.957e8, "unit": "m", "uncertainty": 0, "source": "IAU 2015 B3 nominal" },
    "L_sun":    { "value": 3.828e26, "unit": "W", "uncertainty": 0, "source": "IAU 2015 B3 nominal" },
    "TSI":      { "value": 1361, "unit": "W/m^2", "uncertainty": 0, "source": "IAU 2015 B3 nominal S (Kopp & Lean 2011, GRL 38:L01706)" },
    "Teff_sun": { "value": 5772, "unit": "K", "uncertainty": 0, "source": "IAU 2015 B3 nominal" },
    "AU":       { "value": 149597870700, "unit": "m", "uncertainty": 0, "source": "IAU 2012 Resolution B2 (exact)" },
    "GM_earth": { "value": 3.986004418e14, "unit": "m^3/s^2", "uncertainty": 8e5, "source": "IERS 2010 / WGS84 (held fixed when G changes)" },
    "R_earth_eq":   { "value": 6.3781e6, "unit": "m", "uncertainty": 0, "source": "IAU 2015 B3 nominal equatorial" },
    "R_earth_mean": { "value": 6.3710088e6, "unit": "m", "uncertainty": 0, "source": "IUGG mean radius R1 (Moritz 2000)" },
    "GM_jup":   { "value": 1.2668653e17, "unit": "m^3/s^2", "uncertainty": 0, "source": "IAU 2015 B3 nominal" },
    "R_jup_eq": { "value": 7.1492e7, "unit": "m", "uncertainty": 0, "source": "IAU 2015 B3 nominal" },
    "wgs84_a":  { "value": 6378137, "unit": "m", "uncertainty": 0, "source": "WGS84 (NGA TR8350.2)" },
    "wgs84_invf": { "value": 298.257223563, "unit": "1", "uncertainty": 0, "source": "WGS84" },
    "omega_earth": { "value": 7.292115e-5, "unit": "rad/s", "uncertainty": 0, "source": "WGS84 / IERS 2010" },
    "J2_earth": { "value": 1.08263e-3, "unit": "1", "uncertainty": 0, "source": "WGS84 / EGM2008 dynamic form factor" },
    "julian_year_d": { "value": 365.25, "unit": "d", "uncertainty": 0, "source": "IAU definition" },
    "day_s":    { "value": 86400, "unit": "s", "uncertainty": 0, "source": "SI" },
    "J2000_JD": { "value": 2451545.0, "unit": "d", "uncertainty": 0, "source": "IAU J2000.0 epoch (2000-01-01 12:00 TT)" },
    "x_N2_dry": { "value": 0.78084, "unit": "mol/mol", "uncertainty": 0, "source": "Dry air by volume, NOAA / CRC Handbook of Chemistry and Physics" },
    "x_O2_dry": { "value": 0.20946, "unit": "mol/mol", "uncertainty": 0, "source": "Dry air by volume, NOAA / CRC Handbook of Chemistry and Physics" },
    "x_Ar_dry": { "value": 0.00934, "unit": "mol/mol", "uncertainty": 0, "source": "Dry air by volume, NOAA / CRC Handbook of Chemistry and Physics" },
    "earth_moi_prem": { "value": 0.330799, "unit": "1", "uncertainty": 1e-5, "source": "C/(M R^2) integrated from PREM (Dziewonski & Anderson 1981) in rust interior.rs moi_factor(); test-locked to it" },
    "CO2_ppm_present": { "value": 422.8, "unit": "ppm", "uncertainty": 0.1, "source": "NOAA GML global marine surface annual mean 2024 (Lan et al.); overridden by the climate seed in deep time" }
  },
  "math": {
    "PI": "Math.PI", "TAU": "2*Math.PI", "E": "Math.E", "PHI": "(1+Math.sqrt(5))/2", "SQRT2": "Math.SQRT2", "LN2": "Math.LN2",
    "DEG": "Math.PI/180", "RAD2DEG": "180/Math.PI", "ARCSEC": "Math.PI/648000",
    "GOLDEN_ANGLE": "Math.PI*(3-Math.sqrt(5))", "GOLDEN_ANGLE_DEG": "180*(3-Math.sqrt(5))",
    "WIEN_X": "wienX()"
  },
  "derived": {
    "hbar":   { "formula": "h/(2*PI)", "unit": "J s", "source": "definition" },
    "R":      { "formula": "N_A*k_B", "unit": "J/(mol K)", "source": "definition" },
    "F":      { "formula": "N_A*e", "unit": "C/mol", "source": "Faraday constant" },
    "sigma":  { "formula": "2*PI**5*k_B**4/(15*h**3*c**2)", "unit": "W/(m^2 K^4)", "source": "Stefan-Boltzmann from Planck's law" },
    "wien_b": { "formula": "h*c/(k_B*WIEN_X)", "unit": "m K", "source": "root x of x = 5(1-e^-x) of Planck's law" },
    "eps0":   { "formula": "e**2/(2*alpha*h*c)", "unit": "F/m", "source": "alpha = e^2/(4 pi eps0 hbar c)" },
    "mu0":    { "formula": "1/(eps0*c**2)", "unit": "N/A^2", "source": "c^2 = 1/(mu0 eps0)" },
    "m_e":    { "formula": "2*R_inf*h/(c*alpha**2)", "unit": "kg", "source": "R_inf = alpha^2 m_e c/(2h)" },
    "m_p":    { "formula": "m_e/me_mp", "unit": "kg", "source": "ratio" },
    "l_P":    { "formula": "Math.sqrt(hbar*G/c**3)", "unit": "m", "source": "Planck length" },
    "t_P":    { "formula": "l_P/c", "unit": "s", "source": "Planck time" },
    "m_P":    { "formula": "Math.sqrt(hbar*c/G)", "unit": "kg", "source": "Planck mass" },
    "T_P":    { "formula": "m_P*c**2/k_B", "unit": "K", "source": "Planck temperature" },
    "M_sun":  { "formula": "GM_sun/G", "unit": "kg", "source": "GM_sun fixed, so M_sun follows G" },
    "M_earth":{ "formula": "GM_earth/G", "unit": "kg", "source": "GM_earth fixed, so M_earth follows G" },
    "M_jup":  { "formula": "GM_jup/G", "unit": "kg", "source": "GM_jup fixed" },
    "wgs84_f":{ "formula": "1/wgs84_invf", "unit": "1", "source": "WGS84" },
    "julian_year_s": { "formula": "julian_year_d*day_s", "unit": "s", "source": "IAU" },
    "AU_km":  { "formula": "AU/1000", "unit": "km", "source": "IAU 2012" },
    "g_earth_mean": { "formula": "GM_earth/R_earth_mean**2", "unit": "m/s^2", "source": "Newtonian surface gravity at the mean radius (no rotation)" }
  }
}
